# Copy to agent/.env and fill in. Never commit the real key.
OPENROUTER_API_KEY=

# Generative model used for planning and verification (OpenRouter slug, e.g. a frontier chat model).
# Empty means: planner/verifier calls will fail unless fakes are used.
OPENROUTER_CHAT_MODEL=

# JEV decision model. Pinned by default; override to track an alias deliberately.
OPENROUTER_JEV_MODEL=typesafe/jev-1.13

# Endpoints. Override only for proxies or tests.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions

# Dev bridge between the orchestrator and the Chrome extension (WebSocket).
REMORA_WS_HOST=127.0.0.1
REMORA_WS_PORT=8787
# Shared token the extension must present in bridge.hello. Empty disables the check (dev only).
REMORA_BRIDGE_TOKEN=

# Control channel between the orchestrator and the macOS app.
REMORA_CONTROL_HOST=127.0.0.1
REMORA_CONTROL_PORT=8790
# Shared token the macOS app must present in control.hello. Empty disables the check (dev only).
REMORA_CONTROL_TOKEN=

# Loop budgets and thresholds.
REMORA_MAX_STEPS_PER_MILESTONE=30
REMORA_MAX_TOTAL_STEPS=120
REMORA_CONFIDENCE_THRESHOLD=0.55
REMORA_ACTION_TIMEOUT_MS=20000
REMORA_OBSERVE_TIMEOUT_MS=15000
REMORA_MAX_REPAIR_ATTEMPTS=1
REMORA_MAX_ELEMENTS=120
REMORA_MAX_TEXT_LENGTH=160
